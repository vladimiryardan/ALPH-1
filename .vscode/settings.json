{
  "liveServer.settings.port": 5501,

  "editor.wordWrap": "on",
  "editor.semanticHighlighting.enabled": true,
  "editor.minimap.enabled": false,

  "editor.quickSuggestions": {
    "other": false,
    "comments": false,
    "strings": false
  },

  "editor.codeActionsOnSave": {},

  "files.autoSave": "off",

  "workbench.colorCustomizations": {
    "diffEditor.insertedLineBackground": "#d9ead355",
    "diffEditor.insertedTextBackground": "#b7d7b755",
    "diffEditor.insertedTextBorder": "#7fa87f",

    "diffEditor.removedLineBackground": "#f4cccc55",
    "diffEditor.removedTextBackground": "#e6a6a655",
    "diffEditor.removedTextBorder": "#c98282",

    "diffEditorOverview.insertedForeground": "#999999",
    "diffEditorOverview.removedForeground": "#777777",

    "editorGutter.addedBackground": "#AAAAAA",
    "editorGutter.modifiedBackground": "#888888",
    "editorGutter.deletedBackground": "#666666",

    "editorOverviewRuler.addedForeground": "#AAAAAA",
    "editorOverviewRuler.modifiedForeground": "#888888",
    "editorOverviewRuler.deletedForeground": "#666666",

    "editor.selectionBackground": "#ADD6FF",
    "editor.inactiveSelectionBackground": "#DDE8F2"
  }
}